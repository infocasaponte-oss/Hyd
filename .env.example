# Copyright (c) 2026 Luis Manuel Cousido Hermida. All rights reserved.
# Copy to .env and adjust. Every HYDRA setting uses the HYDRA_ prefix.

# Protect the gateway (strongly recommended outside localhost).
HYDRA_API_KEY=change-me

# Run without any model runtime (deterministic offline models).
HYDRA_OFFLINE=false

# Infrastructure (empty = in-memory).
HYDRA_POSTGRES_URL=
HYDRA_REDIS_URL=
# Execution-fabric queue: auto (PostgreSQL when HYDRA_POSTGRES_URL is set and psycopg is installed,
# shared by every node; else local SQLite) | sqlite | postgres (required).
HYDRA_FABRIC_BACKEND=auto
# Signed IP/provenance ledger: auto (PostgreSQL when available, shared by every node; an existing
# data/ledger file ledger is verified and imported once, the file is kept) | file | postgres.
HYDRA_LEDGER_BACKEND=auto
# Corpus logs (records, lineage, tombstones, snapshots): auto (PostgreSQL table hydra_logs when available,
# shared by every node; existing data/corpus files are imported once and kept) | file | postgres.
HYDRA_CORPUS_BACKEND=auto
# World Model delta log and snapshots: same choices (streams world/* of hydra_logs).
HYDRA_WORLD_BACKEND=auto
# Invention registry (IP): same choices (stream ip/inventions.jsonl of hydra_logs).
HYDRA_IP_BACKEND=auto
# Artifact manifests: same choices (stream artifacts/manifests.jsonl). Blobs: empty = data/artifacts/objects,
# a directory every node mounts, or s3://bucket/prefix (pip install "hydra-engine[s3]"; AWS_* credentials).
# Objects already in data/artifacts/objects are copied there once (re-hashed; the local copies are kept).
HYDRA_ARTIFACTS_BACKEND=auto
# Capture outbox (deferred ledger/corpus writes): auto (PostgreSQL table capture_outbox when available;
# unpublished SQLite messages are imported once) | sqlite | postgres.
HYDRA_OUTBOX_BACKEND=auto
# Runtime-line state (event and provenance chains, live-traffic evidence, deployment registry, and the
# hydra.db stores: outbox, task commits, metrics, runtime health, promotion evidence): auto (PostgreSQL streams runtime/* of hydra_logs when
# available; existing files under HYDRA_RUNTIME_DIR are imported once and kept) | file | postgres.
HYDRA_RUNTIME_BACKEND=auto
# Small shared registries (feature flags, config sets, secret vault, lab, glossaries, model lifecycle,
# factory registry and adapters, failure memory, edge sync state): auto (PostgreSQL hydra_documents and
# hydra_logs when available; existing files under HYDRA_DATA_DIR are adopted once and kept) | file | postgres.
HYDRA_DOCUMENTS_BACKEND=auto
HYDRA_ARTIFACT_OBJECTS=
# S3-compatible endpoint (MinIO, Ceph, R2...); empty for AWS S3.
HYDRA_S3_ENDPOINT_URL=

# Runtimes
HYDRA_OLLAMA_BASE_URL=http://localhost:11434
HYDRA_VLLM_BASE_URL=http://localhost:8000/v1
HYDRA_VLLM_REASONER_URL=http://localhost:8000/v1
HYDRA_VLLM_CODER_URL=http://localhost:8001/v1
HYDRA_VLLM_VISION_URL=http://localhost:8002/v1
HYDRA_LLAMACPP_BASE_URL=http://localhost:8081/v1

# Optional cloud escalation (disabled when empty; PRIVATE mode never uses it).
HYDRA_CLOUD_BASE_URL=https://api.openai.com/v1
HYDRA_CLOUD_API_KEY=

# Model catalogue (config/models.ollama.yaml = local Ollama workstation).
HYDRA_MODELS_CONFIG=config/models.yaml
# Policy Kernel rules.
HYDRA_POLICY_CONFIG=config/policy.yaml
# Local state: failure memory, HYDRA Lab experiments, Model Factory store.
HYDRA_DATA_DIR=data

# Optional System-One routing classifier (a model id from the models config).
HYDRA_ROUTER_MODEL=

# Hyd owns the typed decision plane; runs in-process without a Kev sidecar.
HYDRA_HYD_ENABLED=true
HYDRA_HYD_MODEL_PATH=config/hyd/model.json
HYDRA_HYD_CALIBRATION_PATH=config/hyd/calibration.json
# Routing control requires independent evidence bound to these exact artifacts.
HYDRA_HYD_AUTHORITY_EVIDENCE_PATH=
# Embeddings: hashing (no model) | ollama | vllm
HYDRA_EMBEDDING_PROVIDER=hashing
HYDRA_EMBEDDING_MODEL=
# e.g. HYDRA_EMBEDDING_PROVIDER=ollama HYDRA_EMBEDDING_MODEL=nomic-embed-text

# Local GPUs load models cold: stretch time budgets (2-4 recommended for Ollama on 8-16 GB VRAM).
HYDRA_BUDGET_TIME_SCALE=1
# Load-aware routing from vLLM/llama.cpp /metrics, Ollama /api/ps and nvidia-smi.
HYDRA_RUNTIME_MONITOR=true
# NATS JetStream bus (takes precedence over Redis): nats://localhost:4222
HYDRA_NATS_URL=
# Model Factory: llama.cpp checkout/build with convert_hf_to_gguf.py, llama-quantize, llama-imatrix...
HYDRA_LLAMACPP_DIR=

# Sandbox: docker (isolated container) | subprocess (development only, not a security boundary)
HYDRA_SANDBOX_BACKEND=docker
HYDRA_SANDBOX_IMAGE=python:3.12-slim

# Domains research workers may fetch from (comma separated).
HYDRA_NETWORK_DOMAINS=wikipedia.org,arxiv.org,github.com,python.org

POSTGRES_PASSWORD=hydra
HF_TOKEN=

# ---- HYDRA 1.0 planes -------------------------------------------------------------
# Capture pipeline (World Model, content-addressed artifacts, corpus, signed ledger, flight recorder).
HYDRA_CAPTURE=true
# Own executions at or below this sensitivity are trainable by default (0=PUBLIC, 1=INTERNAL).
HYDRA_CORPUS_AUTO_TRAINING_MAX_SENSITIVITY=0
# Deterministic-first: calculator / sympy / JSON / SQL solvers answer without models when certain.
HYDRA_DETERMINISTIC_FIRST=false
# Policy DSL and license profiles.
HYDRA_POLICY_RULES_CONFIG=config/policy_rules.yaml
HYDRA_LICENSES_CONFIG=config/licenses.yaml
# Cluster: node id (default hostname), placement re-ranking and heartbeat period.
HYDRA_NODE_ID=
HYDRA_CLUSTER_RERANK=true
HYDRA_HEARTBEAT_INTERVAL_S=15
# OpenTelemetry OTLP/HTTP endpoint (GenAI semantic conventions), e.g. http://localhost:4318
HYDRA_OTEL_ENDPOINT=
# AutoBuilder llama-server binary (hydra build --auto --runtime llama.cpp).
HYDRA_LLAMA_SERVER=
# Secrets Broker: tools receive secret://group/name references resolved at execution time, e.g.
# HYDRA_SECRET_GITHUB_TOKEN=ghp_...   (models never see the value)
# Signed ledger: write a Merkle anchor every N events.
HYDRA_LEDGER_ANCHOR_EVERY=1000
# Model invocation: hedge a slow call to a second model after this many ms; open a model's
# circuit breaker after N consecutive failures and retry it after the cooldown.
HYDRA_HEDGE_AFTER_MS=3500
HYDRA_BREAKER_FAILURES=5
HYDRA_BREAKER_COOLDOWN_S=60
# Runtime metrics poll period for load-aware routing (see HYDRA_RUNTIME_MONITOR).
HYDRA_MONITOR_INTERVAL_S=5
# Default model for 'hydra build' (AutoBuilder) when --model is not given.
HYDRA_MODEL=
# Deferred capture writes (ledger/corpus) are retried from data/capture_outbox.db this often.
HYDRA_CAPTURE_OUTBOX_POLL_S=2
# Request budgets (translation and runtime chat): input characters and translation chunks.
HYDRA_MAX_INPUT_CHARS=50000
HYDRA_MAX_TRANSLATION_CHUNKS=64
HYDRA_API_RATE_LIMIT_PER_MINUTE=60

# ---- HYDRA-SO runtime line (served by the same gateway; see docs/runtime/) ---------
# /ready, /v1/chat, /hydra/v1/tasks/route|execute, /hydra/v1/admin/*, /hydra/v1/coding/verify-fix
HYDRA_RUNTIME_API=true
# Anchor runtime/events.jsonl + runtime/provenance.jsonl heads in the signed ledger (seconds).
HYDRA_RUNTIME_ANCHOR_INTERVAL_S=300
# HYDRA_API_TOKEN is accepted as an alias of HYDRA_API_KEY (one token for both lines).
# HYDRA_ADMIN_TOKEN (header X-Hydra-Admin-Token) protects every state-changing operator route:
# runtime admin (deployments, dead letters, metrics, coding) fails closed without it; platform
# governance (flags, config sets, corpus approval, IP, releases, model lifecycle, sync, explicit goal
# authorizations) accepts loopback clients only while it is empty.
HYDRA_ADMIN_TOKEN=
# Private keys (ledger Ed25519, secrets broker, IP vault) never live in HYDRA_DATA_DIR:
# auto = OS keyring (pip install "hydra-engine[keys]") -> HYDRA_KEYS_DIR -> legacy data-dir files.
# Existing data-dir keys are migrated (verified, then deleted) when a secure backend is available.
# Containers: HYDRA_KEYS_DIR on its own volume, or HYDRA_KEY_LEDGER_ED25519 / HYDRA_KEY_SECRETS_BROKER.
HYDRA_KEY_BACKEND=auto
HYDRA_KEYS_DIR=
# Edge sync imports trust this node's key plus *.pub.pem files here (default <data_dir>/keys/trusted).
HYDRA_SYNC_TRUSTED_KEYS_DIR=
# Bearer token for internal vLLM / llama.cpp servers started with --api-key (empty: no header).
HYDRA_INTERNAL_API_KEY=
# Grafana admin password for the observability compose profile.
GRAFANA_ADMIN_PASSWORD=
HYDRA_ADMIN_RATE_LIMIT_PER_MINUTE=6
# Only for the standalone runtime app (scripts/run_api.sh); 'hydra serve' takes --host/--port.
HYDRA_API_HOST=127.0.0.1
HYDRA_API_PORT=8080
# llama-server used by the runtime line (not exposed directly).
HYDRA_LLM_URL=http://127.0.0.1:8081/v1
HYDRA_MODELS_DIR=models
# API clients (goals, code graph, coding) may only name directories below this root.
HYDRA_REPOSITORIES_ROOT=repositories
HYDRA_RUNTIME_DB=runtime/hydra.db
HYDRA_DEPLOYMENTS_FILE=runtime/deployments.json
HYDRA_READINESS_MAX_PENDING=1000
HYDRA_READINESS_MAX_PENDING_AGE_SECONDS=300
HYDRA_MAX_OUTPUT_TOKENS=4096
# Code agent sandbox: build it with infra/sandbox (Python 3.12, pytest, ruff, mypy). Setting
# HYDRA_SANDBOX_IMAGE=hydra-sandbox:py312-v3 above hardens the platform sandbox too.
HYDRA_SANDBOX_RUNTIME=docker
HYDRA_CODE_VERIFICATION_MODE=advisory
HYDRA_WORKSPACE_MAX_FILES=20000
HYDRA_WORKSPACE_MAX_BYTES=268435456
