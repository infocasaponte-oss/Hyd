@@ -0,0 +1,43 @@
+import { afterEach, describe, expect, it } from "vitest";
+import { mkdtemp, rm, readFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { actorKey, cancelJob, enqueueJob, listJobs, reviewedPlan } from "./corpus-queue.server";
+
+const roots: string[] = [];
+afterEach(async () => {
+  for (const root of roots.splice(0)) await rm(root, { recursive: true, force: true });
+});
+const plan = {
+  format: "hyd-corpus-download-plan/1",
+  source_id: "boe",
+  asset_url: "https://www.boe.es/fixture.xml",
+  max_bytes: 1024,
+  rights: { verified: true, license: "public-domain", evidence_url: "https://www.boe.es/review" },
+  training_allowed: false,
+  state: "prepared",
+};
+describe("persistent account queue", () => {
+  it("persists jobs, isolates accounts and restricts cancellation", async () => {
+    const root = await mkdtemp(join(tmpdir(), "hyd-corpus-queue-"));
+    roots.push(root);
+    const job = await enqueueJob(root, "account-a", plan);
+    expect((await listJobs(root, "account-a"))[0]?.state).toBe("queued");
+    expect(await listJobs(root, "account-b")).toEqual([]);
+    await expect(cancelJob(root, "account-b", job.id)).rejects.toThrow("non atopado");
+    await cancelJob(root, "account-a", job.id);
+    expect((await listJobs(root, "account-a"))[0]?.state).toBe("cancelled");
+    const request = JSON.parse(
+      await readFile(join(root, actorKey("account-a"), job.id, "request.json"), "utf8"),
+    );
+    expect(request.plan_sha256).toMatch(/^[0-9a-f]{64}$/);
+    expect(request).not.toHaveProperty("user_id");
+  });
+  it("cannot enqueue unreviewed rights or unsupported sources", () => {
+    expect(() => reviewedPlan({ ...plan, rights: { ...plan.rights, verified: false } })).toThrow();
+    expect(() => reviewedPlan({ ...plan, source_id: "elpais" })).toThrow();
+    expect(() =>
+      reviewedPlan({ ...plan, asset_url: "https://www.boe.es.evil.example/file" }),
+    ).toThrow();
+  });
+});
