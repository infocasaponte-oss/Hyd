+import { createServerFn } from "@tanstack/react-start";
+import { z } from "zod";
+import { requireSupabaseAuth } from "@/integrations/supabase/auth-middleware";
+import { downloadPlanSchema } from "./corpus-workspace";
+
+export const listCorpusJobs = createServerFn({ method: "GET" })
+  .middleware([requireSupabaseAuth])
+  .handler(async ({ context }) => {
+    const queue = await import("./corpus-queue.server");
+    const root = queue.queueRoot();
+    return { enabled: Boolean(root), jobs: root ? await queue.listJobs(root, context.userId) : [] };
+  });
+export const createCorpusJob = createServerFn({ method: "POST" })
+  .middleware([requireSupabaseAuth])
+  .validator((input) => downloadPlanSchema.parse(input))
+  .handler(async ({ data, context }) => {
+    const queue = await import("./corpus-queue.server");
+    const root = queue.queueRoot();
+    if (!root) throw new Error("Axente local aínda non conectado.");
+    return queue.enqueueJob(root, context.userId, data);
+  });
+export const cancelCorpusJob = createServerFn({ method: "POST" })
+  .middleware([requireSupabaseAuth])
+  .validator((input) => z.object({ id: z.string().uuid() }).strict().parse(input))
+  .handler(async ({ data, context }) => {
+    const queue = await import("./corpus-queue.server");
+    const root = queue.queueRoot();
+    if (!root) throw new Error("Axente local aínda non conectado.");
+    return queue.cancelJob(root, context.userId, data.id);
+  });
diff --git a/src/lib/corpus-queue.server.ts b/src/lib/corpus-queue.server.ts
new file mode 100644
index 0000000..aac9a04
--- /dev/null
+++ b/src/lib/corpus-queue.server.ts
@@ -0,0 +1,124 @@
+import { createHash, randomUUID } from "node:crypto";
+import { mkdir, readFile, readdir, writeFile, access, rename } from "node:fs/promises";
+import { isAbsolute, join } from "node:path";
+import { downloadPlanSchema } from "./corpus-workspace";
+
+export function actorKey(actor: string) {
+  return createHash("sha256")
+    .update("hyd-corpus-actor/1:" + actor)
+    .digest("hex");
+}
+export function queueRoot() {
+  const root = process.env["HYD_CORPUS_QUEUE_DIR"];
+  if (!root) return null;
+  if (!isAbsolute(root)) throw new Error("A cola require un directorio absoluto configurado.");
+  return root;
+}
+const hosts: Record<string, string[]> = {
+  boe: ["www.boe.es", "boe.es"],
+  congreso: ["www.congreso.es", "congreso.es"],
+  rtve: ["www.rtve.es", "rtve.es"],
+  gutenberg: ["www.gutenberg.org", "gutenberg.org"],
+  cervantes: ["www.cervantesvirtual.com", "cervantesvirtual.com"],
+};
+export function reviewedPlan(input: unknown) {
+  const plan = downloadPlanSchema.parse(input);
+  const url = new URL(plan.asset_url);
+  if (
+    !hosts[plan.source_id]?.includes(url.hostname) ||
+    url.username ||
+    url.password ||
+    url.hash ||
+    (url.port && url.port !== "443")
+  )
+    throw new Error("Fonte ou URL non habilitada para a descarga local.");
+  if (
+    plan.rights.verified !== true ||
+    !["CC0-1.0", "CC-BY-4.0", "public-domain", "eu-reuse-2011-833"].includes(plan.rights.license)
+  )
+    throw new Error("Require declaración revisada de dereitos e licenza admitida.");
+  const evidence = new URL(plan.rights.evidence_url);
+  if (evidence.protocol !== "https:")
+    throw new Error("Require ligazón HTTPS á evidencia de dereitos.");
+  return plan;
+}
+async function exists(path: string) {
+  try {
+    await access(path);
+    return true;
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return false;
+    throw error;
+  }
+}
+export async function listJobs(root: string, actor: string) {
+  const directory = join(root, actorKey(actor));
+  if (!(await exists(directory))) return [];
+  const entries = await readdir(directory, { withFileTypes: true });
+  const jobs = [];
+  for (const entry of entries) {
+    if (!entry.isDirectory() || !/^[0-9a-f-]{36}$/.test(entry.name)) continue;
+    const folder = join(directory, entry.name);
+    const request = JSON.parse(await readFile(join(folder, "request.json"), "utf8"));
+    let state = "initializing";
+    let result = null;
+    if (await exists(join(folder, "result.json"))) {
+      result = JSON.parse(await readFile(join(folder, "result.json"), "utf8"));
+      state = result.state;
+    } else if (await exists(join(folder, "cancel")))
+      state = (await exists(join(folder, "running"))) ? "cancel_requested" : "cancelled";
+    else if (await exists(join(folder, "running"))) state = "running";
+    else if (await exists(join(folder, "queued"))) state = "queued";
+    jobs.push({
+      id: entry.name,
+      source_id: request.source_id as string,
+      created_at: request.created_at as string,
+      max_bytes: request.max_bytes as number,
+      state: state as string,
+      result_json: result ? JSON.stringify(result) : null,
+    });
+  }
+  return jobs.sort((a, b) => b.created_at.localeCompare(a.created_at));
+}
+export async function enqueueJob(root: string, actor: string, input: unknown) {
+  const plan = reviewedPlan(input);
+  const jobs = await listJobs(root, actor);
+  if (
+    jobs.length >= 500 ||
+    jobs.filter((job) =>
+      ["queued", "running", "initializing", "cancel_requested"].includes(job.state),
+    ).length >= 20
+  )
+    throw new Error("Límite de traballos alcanzado; revisa a cola.");
+  const id = randomUUID();
+  const folder = join(root, actorKey(actor), id);
+  const pending = folder + ".pending";
+  const raw = JSON.stringify(plan);
+  await mkdir(pending, { recursive: true, mode: 0o700 });
+  await writeFile(join(pending, "plan.json"), raw, { flag: "wx" });
+  await writeFile(
+    join(pending, "request.json"),
+    JSON.stringify({
+      id,
+      actor_key: actorKey(actor),
+      source_id: plan.source_id,
+      plan_sha256: createHash("sha256").update(raw).digest("hex"),
+      max_bytes: plan.max_bytes,
+      created_at: new Date().toISOString(),
+      training_allowed: false,
+    }),
+    { flag: "wx" },
+  );
+  await writeFile(join(pending, "queued"), "", { flag: "wx" });
+  await rename(pending, folder);
+  return { id };
+}
+export async function cancelJob(root: string, actor: string, id: string) {
+  if (!/^[0-9a-f-]{36}$/.test(id)) throw new Error("ID de traballo inválido.");
+  const folder = join(root, actorKey(actor), id);
+  if (!(await exists(join(folder, "request.json"))))
+    throw new Error("Traballo non atopado nesta conta.");
+  if (await exists(join(folder, "result.json"))) return { requested: false };
+  await writeFile(join(folder, "cancel"), "cancel requested");
+  return { requested: true };
+}
