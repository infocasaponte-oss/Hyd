+import { z } from "zod";
+
+export const corpusSources = [
+  {
+    id: "wikipedia-es",
+    name: "Wikipedia ES",
+    domain: "Enciclopedia",
+    url: "https://dumps.wikimedia.org/eswiki/",
+    state: "require_review",
+    note: "CC BY-SA: revisar compatibilidade coa política actual antes de descargar.",
+  },
+  {
+    id: "opensubtitles-es",
+    name: "OpenSubtitles ES",
+    domain: "Diálogo",
+    url: "https://opus.nlpl.eu/",
+    state: "require_review",
+    note: "Disponibilidade en OPUS non acredita dereitos sobre cada subtítulo.",
+  },
+  {
+    id: "boe",
+    name: "BOE",
+    domain: "Lexislación",
+    url: "https://www.boe.es/",
+    state: "require_review",
+    note: "Revisar reutilización e conservar a orixe do documento; evitar encher lingua xeral con textos legais.",
+  },
+  {
+    id: "congreso",
+    name: "Congreso",
+    domain: "Debate parlamentario",
+    url: "https://www.congreso.es/",
+    state: "require_review",
+    note: "Revisar condicións e tipo de documento antes de preparar un lote.",
+  },
+  {
+    id: "elpais",
+    name: "El País",
+    domain: "Noticias",
+    url: "https://elpais.com/info/aviso-legal/",
+    state: "require_permission",
+    note: "RSS non concede permiso de adestramento; autorización pendente.",
+  },
+  {
+    id: "elmundo",
+    name: "El Mundo",
+    domain: "Noticias",
+    url: "https://www.elmundo.es/",
+    state: "require_permission",
+    note: "RSS non concede permiso de adestramento; autorización pendente.",
+  },
+  {
+    id: "rtve",
+    name: "RTVE",
+    domain: "Noticias",
+    url: "https://www.rtve.es/",
+    state: "require_review",
+    note: "Revisar condicións. Un endpoint JSON non é un feed RSS.",
+  },
+  {
+    id: "gutenberg",
+    name: "Gutenberg ES",
+    domain: "Libros",
+    url: "https://www.gutenberg.org/policy/license.html",
+    state: "require_review",
+    note: "Comprobar obra, edición, tradución e territorio; dominio público nos EUA non acredita o de España.",
+  },
+  {
+    id: "cervantes",
+    name: "Biblioteca Cervantes",
+    domain: "Libros",
+    url: "https://www.cervantesvirtual.com/",
+    state: "require_review",
+    note: "Revisar por obra e edición; acceso libre non implica licenza de adestramento.",
+  },
+] as const;
+
+export const downloadPlanSchema = z
+  .object({
+    format: z.literal("hyd-corpus-download-plan/1"),
+    source_id: z.enum([
+      "wikipedia-es",
+      "opensubtitles-es",
+      "boe",
+      "congreso",
+      "elpais",
+      "elmundo",
+      "rtve",
+      "gutenberg",
+      "cervantes",
+    ]),
+    asset_url: z
+      .string()
+      .url()
+      .refine((url) => new URL(url).protocol === "https:", "Require HTTPS"),
+    max_bytes: z
+      .number()
+      .int()
+      .min(1024)
+      .max(1024 * 1024 * 1024),
+    rights: z
+      .object({
+        verified: z.boolean(),
+        license: z.string().max(200),
+        evidence_url: z.string().max(2000),
+      })
+      .strict(),
+    training_allowed: z.literal(false),
+    state: z.literal("prepared"),
+  })
+  .strict();
+
+const groupSchema = z
+  .object({
+    category: z.string(),
+    source: z.string(),
+    license: z.string(),
+    language: z.string(),
+    rows: z.number().int().nonnegative(),
+    characters: z.number().int().nonnegative(),
+    normalized_duplicates: z.number().int().nonnegative().default(0),
+    empty: z.number().int().nonnegative().default(0),
+  })
+  .passthrough();
+export const acquisitionImportSchema = z
+  .object({
+    format: z.literal("acquisition-source-review/1"),
+    snapshot_transactional: z.literal(false),
+    training_admission: z.literal(false),
+    tokens_measured: z.literal(false),
+    download_bytes_measured: z.literal(false),
+    groups: z.array(groupSchema).max(2000),
+    files: z
+      .array(
+        z
+          .object({
+            path: z.string(),
+            bytes: z.number().nonnegative(),
+            sha256: z.string().regex(/^[0-9a-f]{64}$/),
+          })
+          .passthrough(),
+      )
+      .max(20000),
+  })
+  .passthrough();
+
+export function corpusTotals(report: z.infer<typeof acquisitionImportSchema>) {
+  return report.groups.reduce(
+    (total, row) => ({
+      rows: total.rows + row.rows,
+      characters: total.characters + row.characters,
+      duplicates: total.duplicates + row.normalized_duplicates,
+    }),
+    { rows: 0, characters: 0, duplicates: 0 },
+  );
+}
+
+export const downloadResultSchema = z
+  .object({
+    format: z.literal("hyd-corpus-download-result/1"),
+    state: z.literal("downloaded"),
+    source_id: z.string().min(1),
+    asset_url: z.string().url(),
+    bytes: z.number().int().positive(),
+    sha256: z.string().regex(/^[0-9a-f]{64}$/),
+    plan_sha256: z.string().regex(/^[0-9a-f]{64}$/),
+    training_allowed: z.literal(false),
+    rights_basis: z.literal("user-reviewed-declaration"),
+    rights: z.object({
+      verified: z.literal(true),
+      license: z.string().min(1),
+      evidence_url: z.string().url(),
+    }),
+  })
+  .strict();
