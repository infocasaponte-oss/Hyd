diff --git a/src/routes/_authenticated/corpus.tsx b/src/routes/_authenticated/corpus.tsx
new file mode 100644
index 0000000..fb85fef
--- /dev/null
+++ b/src/routes/_authenticated/corpus.tsx
@@ -0,0 +1,258 @@
+import { createFileRoute, Link } from "@tanstack/react-router";
+import { useState } from "react";
+import {
+  acquisitionImportSchema,
+  corpusSources,
+  corpusTotals,
+  downloadPlanSchema,
+  downloadResultSchema,
+} from "@/lib/corpus-workspace";
+import type { z } from "zod";
+
+export const Route = createFileRoute("/_authenticated/corpus")({
+  staticData: { sitemap: false },
+  component: Corpus,
+});
+
+function download(name: string, value: unknown) {
+  const url = URL.createObjectURL(
+    new Blob([JSON.stringify(value, null, 2)], { type: "application/json" }),
+  );
+  const anchor = document.createElement("a");
+  anchor.href = url;
+  anchor.download = name;
+  anchor.click();
+  URL.revokeObjectURL(url);
+}
+
+function Corpus() {
+  const [report, setReport] = useState<z.infer<typeof acquisitionImportSchema> | null>(null);
+  const [error, setError] = useState("");
+  const [downloads, setDownloads] = useState<z.infer<typeof downloadResultSchema>[]>([]);
+  const [source, setSource] = useState<(typeof corpusSources)[number]["id"]>("boe");
+  const [asset, setAsset] = useState("");
+  const [budget, setBudget] = useState(100);
+  const totals = report ? corpusTotals(report) : null;
+  return (
+    <main className="mx-auto max-w-5xl px-6 py-10 font-mono space-y-6">
+      <nav className="flex gap-4">
+        <Link to="/">Panel</Link>
+        <Link to="/evaluar">Avaliación</Link>
+        <Link to="/corpus">Corpus</Link>
+      </nav>
+      <h1 className="text-3xl font-bold">Corpus</h1>
+      <p>Fontes, descargas e preparación de datos de HYDRA e Hyd.</p>
+      <section className="rounded border p-4 space-y-3">
+        <h2 className="font-bold">Inventario real</h2>
+        <p>
+          Importa o informe JSON do descargador local. Os datos desta vista non se gardan no
+          servidor; exporta o informe para conservalos.
+        </p>
+        <input
+          type="file"
+          accept=".json,application/json"
+          aria-label="Importar inventario"
+          onChange={async (event) => {
+            setError("");
+            const file = event.target.files?.[0];
+            if (!file) return;
+            try {
+              if (file.size > 10 * 1024 * 1024) throw new Error("Informe maior de 10 MB.");
+              const parsed = acquisitionImportSchema.parse(JSON.parse(await file.text()));
+              setReport(parsed);
+            } catch (failure) {
+              setError(failure instanceof Error ? failure.message : "Informe inválido.");
+            }
+          }}
+        />
+        {totals ? (
+          <>
+            <p>
+              {totals.rows.toLocaleString()} rexistros · {totals.duplicates.toLocaleString()}{" "}
+              duplicados · {totals.characters.toLocaleString()} caracteres
+            </p>
+            <p>
+              Tokens e tráfico de descarga sen medir. Corpus pendente de admisión; inventario non
+              transaccional.
+            </p>
+            <div className="overflow-auto">
+              <table className="w-full text-xs">
+                <thead>
+                  <tr>
+                    {[
+                      "Categoría",
+                      "Fonte",
+                      "Licenza declarada",
+                      "Idioma",
+                      "Rexistros",
+                      "Duplicados",
+                    ].map((name) => (
+                      <th className="p-2 text-left" key={name}>
+                        {name}
+                      </th>
+                    ))}
+                  </tr>
+                </thead>
+                <tbody>
+                  {report?.groups.map((row, index) => (
+                    <tr key={index}>
+                      {[
+                        row.category,
+                        row.source,
+                        row.license,
+                        row.language,
+                        row.rows,
+                        row.normalized_duplicates,
+                      ].map((value, cell) => (
+                        <td className="border-t p-2" key={cell}>
+                          {value}
+                        </td>
+                      ))}
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            </div>
+            <button onClick={() => download("corpus-inventory.json", report)}>
+              Exportar inventario completo
+            </button>
+          </>
+        ) : (
+          <p>Aínda non hai inventario importado. Non se mostran cantidades estimadas.</p>
+        )}
+      </section>
+      <section className="rounded border p-4 space-y-3">
+        <h2 className="font-bold">Fontes propostas</h2>
+        {corpusSources.map((entry) => (
+          <article key={entry.id} className="border-t pt-3">
+            <a href={entry.url} target="_blank" rel="noreferrer" className="font-bold underline">
+              {entry.name}
+            </a>{" "}
+            · {entry.domain}
+            <p>{entry.note}</p>
+            <p>
+              Estado: pendente de {entry.state === "require_permission" ? "permiso" : "revisión"}.
+            </p>
+          </article>
+        ))}
+      </section>
+      <section className="rounded border p-4 space-y-3">
+        <h2 className="font-bold">Preparar unha descarga</h2>
+        <p>
+          Prepara un plan exportable para o descargador local. Gardar o plan non inicia unha
+          descarga. A conexión cun axente de descargas segue pendente.
+        </p>
+        <label className="block">
+          Fonte{" "}
+          <select
+            value={source}
+            onChange={(event) => setSource(event.target.value as typeof source)}
+          >
+            {corpusSources.map((entry) => (
+              <option key={entry.id} value={entry.id}>
+                {entry.name}
+              </option>
+            ))}
+          </select>
+        </label>
+        <label className="block">
+          URL HTTPS do ficheiro{" "}
+          <input
+            className="border p-2 w-full"
+            value={asset}
+            onChange={(event) => setAsset(event.target.value)}
+          />
+        </label>
+        <label className="block">
+          Límite da descarga (MiB){" "}
+          <input
+            type="number"
+            min={1}
+            max={1024}
+            value={budget}
+            onChange={(event) => setBudget(Number(event.target.value))}
+          />
+        </label>
+        <button
+          onClick={() => {
+            setError("");
+            try {
+              const plan = downloadPlanSchema.parse({
+                format: "hyd-corpus-download-plan/1",
+                source_id: source,
+                asset_url: asset,
+                max_bytes: budget * 1024 * 1024,
+                rights: { verified: false, license: "", evidence_url: "" },
+                training_allowed: false,
+                state: "prepared",
+              });
+              download("corpus-download-plan.json", plan);
+            } catch (failure) {
+              setError(failure instanceof Error ? failure.message : "Plan inválido.");
+            }
+          }}
+        >
+          Exportar plan pendente de revisión
+        </button>
+      </section>
+      <section className="rounded border p-4 space-y-3">
+        <h2 className="font-bold">Descargas realizadas</h2>
+        <p>
+          Importa o manifest.json emitido polo descargador. Mostra o resultado gardado, sen simular
+          un seguimento en directo.
+        </p>
+        <input
+          type="file"
+          accept=".json,application/json"
+          aria-label="Importar resultado de descarga"
+          onChange={async (event) => {
+            const file = event.target.files?.[0];
+            if (!file) return;
+            setError("");
+            try {
+              if (file.size > 1024 * 1024) throw new Error("Manifest maior de 1 MB.");
+              const result = downloadResultSchema.parse(JSON.parse(await file.text()));
+              setDownloads((current) => [
+                ...current.filter((item) => item.plan_sha256 !== result.plan_sha256),
+                result,
+              ]);
+            } catch (failure) {
+              setError(failure instanceof Error ? failure.message : "Resultado inválido.");
+            }
+          }}
+        />
+        {downloads.length === 0 ? (
+          <p>Sen resultados importados.</p>
+        ) : (
+          <>
+            {downloads.map((item) => (
+              <article key={item.plan_sha256} className="border-t pt-2 break-all">
+                <p>
+                  {item.source_id} · {item.bytes.toLocaleString()} bytes · descargado
+                </p>
+                <p>{item.asset_url}</p>
+                <p>SHA-256: {item.sha256}</p>
+                <p>Pendente de admisión para adestrar.</p>
+              </article>
+            ))}
+            <button
+              onClick={() =>
+                download("corpus-download-results.json", {
+                  format: "hyd-corpus-download-results/1",
+                  downloads,
+                })
+              }
+            >
+              Exportar resultados importados
+            </button>
+          </>
+        )}
+      </section>
+      {error && (
+        <p role="alert" className="border p-3">
+          {error}
+        </p>
+      )}
+    </main>
+  );
+}
