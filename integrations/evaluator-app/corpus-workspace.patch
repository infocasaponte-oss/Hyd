+++ b/src/lib/corpus-workspace.test.ts
@@ -0,0 +1,76 @@
+import { describe, expect, it } from "vitest";
+import {
+  acquisitionImportSchema,
+  corpusTotals,
+  downloadPlanSchema,
+  downloadResultSchema,
+} from "./corpus-workspace";
+
+describe("corpus workspace", () => {
+  it("accepts bounded worker results while rejecting fabricated training approval", () => {
+    const result = {
+      format: "hyd-corpus-download-result/1",
+      state: "downloaded",
+      source_id: "boe",
+      asset_url: "https://www.boe.es/fixture.xml",
+      bytes: 10,
+      sha256: "a".repeat(64),
+      plan_sha256: "b".repeat(64),
+      training_allowed: false,
+      rights_basis: "user-reviewed-declaration",
+      rights: {
+        verified: true,
+        license: "public-domain",
+        evidence_url: "https://www.boe.es/review",
+      },
+    };
+    expect(downloadResultSchema.safeParse(result).success).toBe(true);
+    expect(downloadResultSchema.safeParse({ ...result, training_allowed: true }).success).toBe(
+      false,
+    );
+  });
+  it("imports actual report format and counts without inventing tokens", () => {
+    const report = acquisitionImportSchema.parse({
+      format: "acquisition-source-review/1",
+      snapshot_transactional: false,
+      training_admission: false,
+      tokens_measured: false,
+      download_bytes_measured: false,
+      files: [],
+      groups: [
+        {
+          category: "fixture",
+          source: "fixture",
+          license: "unknown",
+          language: "es",
+          rows: 10,
+          characters: 100,
+          normalized_duplicates: 2,
+        },
+      ],
+    });
+    expect(corpusTotals(report)).toEqual({ rows: 10, characters: 100, duplicates: 2 });
+    expect(acquisitionImportSchema.safeParse({ ...report, training_admission: true }).success).toBe(
+      false,
+    );
+  });
+  it("plans remain prepared and cannot claim training permission or exceed budget", () => {
+    const plan = {
+      format: "hyd-corpus-download-plan/1",
+      source_id: "boe",
+      asset_url: "https://www.boe.es/fixture.xml",
+      max_bytes: 1024,
+      rights: { verified: false, license: "", evidence_url: "" },
+      training_allowed: false,
+      state: "prepared",
+    };
+    expect(downloadPlanSchema.safeParse(plan).success).toBe(true);
+    for (const changes of [
+      { training_allowed: true },
+      { state: "downloaded" },
+      { max_bytes: 2 ** 40 },
+      { asset_url: "http://www.boe.es/file" },
+    ])
+      expect(downloadPlanSchema.safeParse({ ...plan, ...changes }).success).toBe(false);
+  });
+});
