+import { HYD_CRITERIA, CONSENT_TEXT, CONSENT_VERSION } from "./hyd-contract";
+
+export function archivePayload(
+  records: unknown[],
+  corrections: unknown[],
+  scope: string,
+  cutoff: string,
+) {
+  return {
+    format: "hyd-portable-archive/1",
+    scope,
+    cutoff,
+    snapshot_consistent: false,
+    contains_private_account_data: true,
+    counts: { records: records.length, corrections: corrections.length },
+    contract: {
+      criteria: HYD_CRITERIA,
+      consent_text: CONSENT_TEXT,
+      consent_version: CONSENT_VERSION,
+    },
+    records,
+    corrections,
+    limitations: [
+      "Only currently stored records and opinions; missing or deleted history is not reconstructed.",
+      "Paginated reads are not a transactional snapshot.",
+      "Authentication accounts, credentials and provider-side logs are not included.",
+    ],
+  };
+}
diff --git a/src/lib/hyd-contract.ts b/src/lib/hyd-contract.ts
