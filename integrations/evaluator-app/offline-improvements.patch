@@ -0,0 +1,50 @@
+import { opinionSchema, SECOND_OPINION_PROMPT } from "./hyd-contract";
+
+export function opinionProviderConfig(env: Record<string, string | undefined>) {
+  const endpoint =
+    env["HYD_SECOND_OPINION_ENDPOINT"] || "https://ai.gateway.lovable.dev/v1/chat/completions";
+  const url = new URL(endpoint);
+  const local = ["localhost", "127.0.0.1", "[::1]"].includes(url.hostname);
+  if (
+    (url.protocol !== "https:" && !(url.protocol === "http:" && local)) ||
+    url.username ||
+    url.password ||
+    url.hash
+  ) {
+    throw new Error("Endpoint de segunda opinión non válido.");
+  }
+  const apiKey = env["HYD_SECOND_OPINION_API_KEY"] || env["LOVABLE_API_KEY"];
+  if (!local && !apiKey) throw new Error("A segunda opinión externa non está configurada.");
+  const model =
+    env["HYD_SECOND_OPINION_MODEL"] ||
+    (url.hostname === "ai.gateway.lovable.dev" ? "google/gemini-2.5-flash" : "");
+  if (!model) throw new Error("Configura o modelo do provedor de segunda opinión.");
+  return { endpoint, apiKey, model, local };
+}
+
+export async function requestSecondOpinion(
+  question: string,
+  config: ReturnType<typeof opinionProviderConfig>,
+) {
+  const response = await fetch(config.endpoint, {
+    method: "POST",
+    signal: AbortSignal.timeout(30000),
+    headers: {
+      "Content-Type": "application/json",
+      ...(config.apiKey ? { Authorization: `Bearer ${config.apiKey}` } : {}),
+    },
+    body: JSON.stringify({
+      model: config.model,
+      temperature: 0,
+      response_format: { type: "json_object" },
+      messages: [
+        { role: "system", content: SECOND_OPINION_PROMPT },
+        { role: "user", content: question },
+      ],
+    }),
+  });
+  if (!response.ok) throw new Error(`Erro da segunda opinión (HTTP ${response.status}).`);
+  const payload = await response.json();
+  const opinion = opinionSchema.parse(JSON.parse(payload.choices?.[0]?.message?.content ?? ""));
+  return { opinion, model: typeof payload.model === "string" ? payload.model : config.model };
+}
