diff --git a/src/lib/hyd-workflow.test.ts b/src/lib/hyd-workflow.test.ts
new file mode 100644
index 0000000..3612e06
--- /dev/null
+++ b/src/lib/hyd-workflow.test.ts
@@ -0,0 +1,120 @@
+import { describe, expect, it } from "vitest";
+import {
+  recordSchema,
+  batchSchema,
+  CONSENT_VERSION,
+  opinionSchema,
+  suggestFormatting,
+  correctionSchema,
+  HYD_CRITERIA,
+} from "./hyd-contract";
+import { prepareExport, type ExportRow } from "./hyd-export";
+
+const input = {
+  question: "  Pregunta orixinal?  ",
+  expectedLabel: "chat",
+  consentAccepted: true,
+  consentVersion: CONSENT_VERSION,
+  sourceKind: "human_evaluator",
+  rightsConfirmed: true,
+  externalAiConsent: false,
+};
+const row: ExportRow = {
+  id: "test-id",
+  user_id: "private-user-id",
+  question: "Pregunta dunha persoa",
+  expected_label: "chat",
+  consent: true,
+  consent_text: "test-consent",
+  created_at: "2026-10-04",
+  source_kind: "human_evaluator",
+  rights_license: "user-declared-permission",
+  rights_verified: true,
+};
+
+describe("Human workflow contract", () => {
+  it("requires explicit consent and current version on direct requests", () => {
+    expect(recordSchema.parse(input).question).toBe(input.question);
+    expect(() => recordSchema.parse({ ...input, consentAccepted: false })).toThrow();
+    expect(() => recordSchema.parse({ ...input, consentAccepted: undefined })).toThrow();
+    expect(() => recordSchema.parse({ ...input, consentVersion: "old" })).toThrow();
+  });
+  it("keeps individual and batch text verbatim", () => {
+    const { question, ...common } = input;
+    expect(batchSchema.parse({ ...common, questions: [question] }).questions[0]).toBe(question);
+    expect(() => recordSchema.parse({ ...input, question: "  " })).toThrow();
+    expect(() =>
+      batchSchema.parse({ ...common, questions: [question, question], labels: ["chat"] }),
+    ).toThrow();
+    expect(
+      batchSchema.parse({ ...common, questions: [question, question], labels: ["chat", "coding"] })
+        .labels,
+    ).toEqual(["chat", "coding"]);
+  });
+  it("rejects fabricated, coerced or out of range IA confidence", () => {
+    expect(
+      opinionSchema.parse({ intent: "Intent", label: "chat", confidence: 0.5 }).confidence,
+    ).toBe(0.5);
+    for (const confidence of ["0.9", null, Infinity, NaN, 2, -1]) {
+      expect(() => opinionSchema.parse({ intent: "Intent", label: "chat", confidence })).toThrow();
+    }
+  });
+  it("makes corrections explicit human decisions", () => {
+    expect(suggestFormatting("  Hola   mundo  ")).toBe("Hola mundo");
+    expect(() =>
+      correctionSchema.parse({
+        recordId: "c4f42703-036b-4a12-8918-97dbe08c00ec",
+        correctedText: "Hola mundo",
+        reason: "Espazos",
+        humanAccepted: false,
+      }),
+    ).toThrow();
+  });
+  it("keeps missing context and consequential authorization distinct", () => {
+    expect(HYD_CRITERIA.abstain).toContain("context is missing");
+    expect(HYD_CRITERIA.high_risk_review).toContain("do not execute it");
+  });
+});
+
+describe("Development exports", () => {
+  it("never exports accounts, email or private notes", () => {
+    const result = prepareExport([row]);
+    expect(result.count).toBe(1);
+    expect(result.lines.join()).not.toContain("private-user-id");
+    expect(result.lines.join()).not.toContain("author");
+    expect(JSON.parse(result.lines[0]!).meta.independent_review).toBe(false);
+  });
+  it("does not invent origin or rights for legacy data", () => {
+    const result = prepareExport([{ ...row, source_kind: null, rights_verified: null }]);
+    expect(result.count).toBe(0);
+    const exported = JSON.parse(result.suspectLines[0]!);
+    expect(exported.meta.real).toBe(false);
+    expect(exported.meta.source_kind).toBe("unknown");
+    expect(exported.rights.verified).toBe(false);
+  });
+  it("template suspicion never changes the declared origin", () => {
+    const result = prepareExport(
+      Array.from({ length: 4 }, (_, i) => ({
+        ...row,
+        id: String(i),
+        question: `Estas primeiras catro palabras son iguais variante ${i}`,
+      })),
+    );
+    expect(result.suspectCount).toBe(4);
+    const exported = JSON.parse(result.suspectLines[0]!);
+    expect(exported.meta.real).toBe(true);
+    expect(exported.meta.suspect_template).toBe(true);
+  });
+  it("quarantines conflicting labels instead of selecting a winner", () => {
+    const result = prepareExport([row, { ...row, id: "other", expected_label: "coding" }]);
+    expect(result.conflicts).toBe(1);
+    expect(result.count).toBe(0);
+    expect(result.suspectCount).toBe(2);
+  });
+  it("deduplicates exact copies without rewriting the kept question", () => {
+    const original = { ...row, question: "  Pregunta única  " };
+    const result = prepareExport([original, { ...row, id: "copy", question: "pregunta ÚNICA" }]);
+    expect(result.duplicates).toBe(1);
+    expect(JSON.parse(result.lines[0]!).text).toBe(original.question);
+  });
+});
