--- /dev/null
+++ b/src/integrations/lovable/oauth.test.ts
@@ -0,0 +1,30 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+const calls = vi.hoisted(() => ({ signIn: vi.fn(), setSession: vi.fn() }));
+vi.mock("@lovable.dev/cloud-auth-js", () => ({
+  createLovableAuth: () => ({ signInWithOAuth: calls.signIn }),
+}));
+vi.mock("../supabase/client", () => ({ supabase: { auth: { setSession: calls.setSession } } }));
+import { lovable } from "./index";
+
+describe("OAuth session handoff", () => {
+  beforeEach(() => vi.resetAllMocks());
+  it("does not create a session when OAuth redirects", async () => {
+    calls.signIn.mockResolvedValue({ redirected: true });
+    expect((await lovable.auth.signInWithOAuth("google")).redirected).toBe(true);
+    expect(calls.setSession).not.toHaveBeenCalled();
+  });
+  it("returns a Supabase session error instead of reporting success", async () => {
+    calls.signIn.mockResolvedValue({
+      tokens: { access_token: "test-only", refresh_token: "test-only" },
+    });
+    calls.setSession.mockResolvedValue({ error: new Error("session rejected") });
+    const result = await lovable.auth.signInWithOAuth("google");
+    expect(result.error?.message).toBe("session rejected");
+  });
+  it("propagates provider error without attempting session creation", async () => {
+    calls.signIn.mockResolvedValue({ error: new Error("provider error") });
+    const result = await lovable.auth.signInWithOAuth("google");
+    expect(result.error?.message).toBe("provider error");
+    expect(calls.setSession).not.toHaveBeenCalled();
+  });
+});
