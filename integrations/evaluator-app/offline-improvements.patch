@@ -0,0 +1,134 @@
+import { useState } from "react";
+import { useServerFn } from "@tanstack/react-start";
+import { saveHydCorrection } from "@/lib/hyd-records.functions";
+import { suggestFormatting, SOURCE_KINDS } from "@/lib/hyd-contract";
+
+export type Declarations = {
+  sourceKind: (typeof SOURCE_KINDS)[number];
+  rightsConfirmed: boolean;
+  externalAiConsent: boolean;
+};
+const ORIGIN_NAMES = {
+  user_traffic: "Petición dun usuario real",
+  human_evaluator: "Escrita por min para avaliar",
+  ai_assisted: "Con axuda de IA",
+  synthetic: "Xerada automaticamente",
+  unknown: "Orixe pendente de indicar",
+};
+
+export function DataDeclarations({
+  value,
+  onChange,
+}: {
+  value: Declarations;
+  onChange: (value: Declarations) => void;
+}) {
+  return (
+    <fieldset className="space-y-3 text-xs">
+      <label className="block">
+        Orixe declarada da pregunta
+        <select
+          value={value.sourceKind}
+          onChange={(event) =>
+            onChange({ ...value, sourceKind: event.target.value as Declarations["sourceKind"] })
+          }
+          className="mt-1 w-full rounded border p-2"
+        >
+          {SOURCE_KINDS.map((kind) => (
+            <option key={kind} value={kind}>
+              {ORIGIN_NAMES[kind]}
+            </option>
+          ))}
+        </select>
+      </label>
+      <label className="flex gap-2">
+        <input
+          type="checkbox"
+          checked={value.rightsConfirmed}
+          onChange={(event) => onChange({ ...value, rightsConfirmed: event.target.checked })}
+        />
+        Declaro que teño permiso para achegar e usar este texto no corpus.
+      </label>
+      <label className="flex gap-2">
+        <input
+          type="checkbox"
+          checked={value.externalAiConsent}
+          onChange={(event) => onChange({ ...value, externalAiConsent: event.target.checked })}
+        />
+        Permito enviar esta pregunta á IA externa se pido unha segunda opinión (opcional).
+      </label>
+    </fieldset>
+  );
+}
+
+export function CorrectionForm({ recordId, original }: { recordId: string; original: string }) {
+  const save = useServerFn(saveHydCorrection);
+  const [open, setOpen] = useState(false);
+  const [text, setText] = useState(suggestFormatting(original));
+  const [reason, setReason] = useState("");
+  const [accepted, setAccepted] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState("");
+  async function submit(event: React.FormEvent) {
+    event.preventDefault();
+    if (!accepted) {
+      setMessage("Confirma a variante antes de gardar.");
+      return;
+    }
+    setBusy(true);
+    setMessage("");
+    try {
+      await save({ data: { recordId, correctedText: text, reason, humanAccepted: true } });
+      setMessage(
+        "Variante gardada por separado. O orixinal consérvase; a variante aínda non é etiqueta de referencia.",
+      );
+      setAccepted(false);
+    } catch (error) {
+      setMessage(error instanceof Error ? error.message : "Non se puido gardar.");
+    } finally {
+      setBusy(false);
+    }
+  }
+  return (
+    <div className="mt-3 text-xs">
+      <button type="button" onClick={() => setOpen(!open)} className="rounded border px-3 py-1">
+        {open ? "Pechar revisión" : "Revisar / propoñer corrección"}
+      </button>
+      {open && (
+        <form onSubmit={submit} className="mt-2 space-y-2 rounded border p-3">
+          <p>Orixinal conservado: {original}</p>
+          <p>A proposta inicial só axusta espazos. Revisa ti a escritura e o significado.</p>
+          <textarea
+            value={text}
+            onChange={(event) => setText(event.target.value)}
+            maxLength={4000}
+            rows={3}
+            className="w-full rounded border p-2"
+            aria-label="Variante corrixida"
+          />
+          <input
+            value={reason}
+            onChange={(event) => setReason(event.target.value)}
+            minLength={3}
+            maxLength={1000}
+            required
+            placeholder="Motivo da corrección"
+            className="w-full rounded border p-2"
+          />
+          <label className="flex gap-2">
+            <input
+              type="checkbox"
+              checked={accepted}
+              onChange={(event) => setAccepted(event.target.checked)}
+            />
+            Revisei e acepto esta variante.
+          </label>
+          <button disabled={busy} className="rounded border px-3 py-1">
+            {busy ? "Gardando…" : "Gardar variante"}
+          </button>
+          {message && <p role="status">{message}</p>}
+        </form>
+      )}
+    </div>
+  );
+}
