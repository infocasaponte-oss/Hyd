+import { createServerFn } from "@tanstack/react-start";
+import { requireSupabaseAuth } from "@/integrations/supabase/auth-middleware";
+
+export const listCorpusUploads = createServerFn({ method: "GET" })
+  .middleware([requireSupabaseAuth])
+  .handler(async ({ context }) => {
+    const uploads = await import("./corpus-upload.server");
+    const root = uploads.uploadRoot();
+    return {
+      enabled: Boolean(root),
+      files: root ? await uploads.listUploads(root, context.userId) : [],
+    };
+  });
+export const uploadCorpusFile = createServerFn({ method: "POST" })
+  .middleware([requireSupabaseAuth])
+  .validator((input: FormData) => {
+    if (!(input instanceof FormData)) throw new Error("Carga multipart requirida.");
+    return input;
+  })
+  .handler(async ({ data, context }) => {
+    const uploads = await import("./corpus-upload.server");
+    const root = uploads.uploadRoot();
+    if (!root) throw new Error("Directorio de importación aínda non configurado.");
+    return uploads.storeUpload(root, context.userId, data);
+  });
diff --git a/src/lib/corpus-upload.server.ts b/src/lib/corpus-upload.server.ts
new file mode 100644
index 0000000..1ab0995
--- /dev/null
+++ b/src/lib/corpus-upload.server.ts
@@ -0,0 +1,101 @@
+import { createHash, randomUUID } from "node:crypto";
+import { mkdir, readFile, readdir, writeFile } from "node:fs/promises";
+import { isAbsolute, join, extname } from "node:path";
+import { actorKey, queueRoot } from "./corpus-queue.server";
+
+export const uploadLimit = 20 * 1024 * 1024;
+const extensions = new Set([".pdf", ".epub", ".txt", ".html", ".htm", ".md", ".mobi"]);
+export function uploadRoot() {
+  const configured = process.env["HYD_CORPUS_IMPORT_DIR"];
+  if (configured && !isAbsolute(configured))
+    throw new Error("O directorio de importación debe ser absoluto.");
+  const queue = queueRoot();
+  return configured || (queue ? join(queue, "_imports") : null);
+}
+
+export async function storeUpload(root: string, actor: string, data: FormData) {
+  const file = data.get("file");
+  if (
+    !(file instanceof File) ||
+    !file.name ||
+    file.name.length > 240 ||
+    /[\\/]/.test(file.name) ||
+    [...file.name].some((character) => character.charCodeAt(0) < 32)
+  )
+    throw new Error("Nome de ficheiro inválido.");
+  if (!extensions.has(extname(file.name).toLowerCase())) throw new Error("Formato non admitido.");
+  if (file.size < 1 || file.size > uploadLimit)
+    throw new Error("Cada ficheiro debe ocupar entre 1 byte e 20 MiB.");
+  const source = data.get("source_id") || "unknown";
+  if (
+    typeof source !== "string" ||
+    !["unknown", "elejandria", "textos-info", "openlibrary", "cervantes", "gutenberg"].includes(
+      source,
+    )
+  )
+    throw new Error("Fonte inválida.");
+  const contextUrl = data.get("source_context_url") || "";
+  if (typeof contextUrl !== "string" || contextUrl.length > 2000)
+    throw new Error("URL de procedencia inválida.");
+  if (contextUrl) {
+    const parsed = new URL(contextUrl);
+    if (parsed.protocol !== "https:" || parsed.username || parsed.password)
+      throw new Error("A procedencia require HTTPS sen credenciais.");
+  }
+  const body = Buffer.from(await file.arrayBuffer());
+  if (body.byteLength !== file.size) throw new Error("Tamaño inconsistente.");
+  const id = randomUUID();
+  const folder = join(root, actorKey(actor), id);
+  await mkdir(folder, { recursive: true });
+  await writeFile(join(folder, "asset.raw"), body, { flag: "wx" });
+  const manifest = {
+    format: "hyd-manual-asset/1",
+    id,
+    state: "raw-pending-review",
+    complete: true,
+    original_filename: file.name,
+    extension: extname(file.name).toLowerCase(),
+    bytes: body.byteLength,
+    sha256: createHash("sha256").update(body).digest("hex"),
+    created_at: new Date().toISOString(),
+    source_id: source,
+    source_context_url_declared: contextUrl || null,
+    rights_review: "pending",
+    privacy_review: "pending",
+    decontamination: "pending",
+    training_allowed: false,
+    extraction_performed: false,
+  };
+  await writeFile(join(folder, "manifest.json"), JSON.stringify(manifest, null, 2), { flag: "wx" });
+  return manifest;
+}
+
+export async function listUploads(root: string, actor: string) {
+  const folder = join(root, actorKey(actor));
+  let entries;
+  try {
+    entries = await readdir(folder, { withFileTypes: true });
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return [];
+    throw error;
+  }
+  const results: Awaited<ReturnType<typeof storeUpload>>[] = [];
+  for (const entry of entries) {
+    if (!entry.isDirectory() || !/^[0-9a-f-]{36}$/.test(entry.name)) continue;
+    try {
+      const manifest = JSON.parse(
+        await readFile(join(folder, entry.name, "manifest.json"), "utf8"),
+      );
+      if (
+        manifest.format !== "hyd-manual-asset/1" ||
+        manifest.complete !== true ||
+        manifest.training_allowed !== false
+      )
+        throw new Error("Manifest de importación inválido.");
+      results.push(manifest);
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+    }
+  }
+  return results.sort((a, b) => b.created_at.localeCompare(a.created_at));
+}
