@@ -0,0 +1,44 @@
+// @vitest-environment node
+import { afterEach, describe, expect, it } from "vitest";
+import { mkdtemp, readFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { actorKey } from "./corpus-queue.server";
+import { listUploads, storeUpload } from "./corpus-upload.server";
+const roots: string[] = [];
+afterEach(async () => {
+  for (const root of roots.splice(0)) await rm(root, { recursive: true, force: true });
+});
+function input(name = "obra.txt", bytes = "Fixture real upload") {
+  const data = new FormData();
+  data.set("file", new File([bytes], name));
+  data.set("source_id", "textos-info");
+  return data;
+}
+describe("manual corpus assets", () => {
+  it("preserves bytes, retains multiple files and isolates evaluator accounts", async () => {
+    const root = await mkdtemp(join(tmpdir(), "hyd-assets-"));
+    roots.push(root);
+    const first = await storeUpload(root, "person-a", input());
+    const second = await storeUpload(root, "person-a", input("outra.pdf", "Fixture second"));
+    expect(first.id).not.toBe(second.id);
+    expect(first.sha256).toMatch(/^[a-f0-9]{64}$/);
+    expect(first.training_allowed).toBe(false);
+    expect(first.extraction_performed).toBe(false);
+    expect(await readFile(join(root, actorKey("person-a"), first.id, "asset.raw"), "utf8")).toBe(
+      "Fixture real upload",
+    );
+    expect(await listUploads(root, "person-b")).toEqual([]);
+    expect(await listUploads(root, "person-a")).toHaveLength(2);
+  });
+  it("rejects traversal, executable, empty and oversized uploads", async () => {
+    const root = await mkdtemp(join(tmpdir(), "hyd-assets-"));
+    roots.push(root);
+    for (const bad of [input("..\\escape.txt"), input("run.exe"), input("empty.txt", "")])
+      await expect(storeUpload(root, "a", bad)).rejects.toThrow();
+    const large = new FormData();
+    large.set("file", new File([new Uint8Array(20 * 1024 * 1024 + 1)], "huge.pdf"));
+    await expect(storeUpload(root, "a", large)).rejects.toThrow("20 MiB");
+    expect(await listUploads(root, "a")).toEqual([]);
+  });
+});
