@@ -0,0 +1,127 @@
+import { useState } from "react";
+import { useServerFn } from "@tanstack/react-start";
+import { useQuery } from "@tanstack/react-query";
+import { createHydAnnotation, listHydAnnotations } from "@/lib/hyd-annotations.functions";
+import { annotationSelection } from "@/lib/hyd-annotations";
+import type { z } from "zod";
+
+export function HydAnnotationForm({ recordId }: { recordId: string }) {
+  const [open, setOpen] = useState(false);
+  const [selection, setSelection] = useState<z.infer<typeof annotationSelection>>({
+    riskKind: "unknown",
+    contextStatus: "unknown",
+    abstainReason: "unknown",
+  });
+  const [confirmed, setConfirmed] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const save = useServerFn(createHydAnnotation);
+  const list = useServerFn(listHydAnnotations);
+  const history = useQuery({
+    queryKey: ["hyd-annotations", recordId],
+    queryFn: () => list({ data: { recordId } }),
+    enabled: open,
+  });
+  return (
+    <section className="mt-3 border-t pt-3 text-xs">
+      <button type="button" onClick={() => setOpen(!open)}>
+        Revisión humana e historial
+      </button>
+      {open && (
+        <form
+          className="space-y-2 mt-2"
+          onSubmit={async (event) => {
+            event.preventDefault();
+            setError("");
+            setBusy(true);
+            try {
+              const data = annotationSelection.parse(selection);
+              if (!confirmed) throw new Error("Confirma que esta é a túa revisión humana.");
+              await save({ data: { ...data, recordId, humanConfirmed: true } });
+              setConfirmed(false);
+              await history.refetch();
+            } catch (failure) {
+              setError(failure instanceof Error ? failure.message : "Non se puido gardar.");
+            } finally {
+              setBusy(false);
+            }
+          }}
+        >
+          <p>
+            Cada envío engade unha revisión. Non cambia a pregunta nin a clase. Descoñecido non
+            significa ausencia de risco.
+          </p>
+          {(
+            [
+              [
+                "riskKind",
+                "Risco",
+                [
+                  ["unknown", "Pendente"],
+                  ["benign", "Benigna"],
+                  ["dangerous", "Perigosa"],
+                  ["security", "Seguridade"],
+                  ["privacy", "Privacidade"],
+                  ["high_risk", "Alto risco"],
+                ],
+              ],
+              [
+                "contextStatus",
+                "Contexto",
+                [
+                  ["unknown", "Pendente"],
+                  ["sufficient", "Suficiente"],
+                  ["missing", "Falta contexto"],
+                ],
+              ],
+              [
+                "abstainReason",
+                "Motivo de abstención",
+                [
+                  ["unknown", "Pendente"],
+                  ["none", "Non require abstención"],
+                  ["dangerous", "Perigosa"],
+                  ["missing_context", "Falta contexto"],
+                ],
+              ],
+            ] as const
+          ).map(([key, label, options]) => (
+            <label key={key} className="block">
+              {label}
+              <select
+                className="ml-2 border rounded p-1"
+                value={selection[key]}
+                onChange={(event) => setSelection({ ...selection, [key]: event.target.value })}
+              >
+                {options.map(([value, name]) => (
+                  <option key={value} value={value}>
+                    {name}
+                  </option>
+                ))}
+              </select>
+            </label>
+          ))}
+          <label className="block">
+            <input
+              type="checkbox"
+              checked={confirmed}
+              onChange={(event) => setConfirmed(event.target.checked)}
+            />{" "}
+            Confirmo que revisei eu esta pregunta.
+          </label>
+          <button type="submit" disabled={busy || !confirmed}>
+            {busy ? "Gardando…" : "Engadir revisión"}
+          </button>
+          {error && <p role="alert">{error}</p>}
+          {history.error && <p role="alert">{history.error.message}</p>}
+          <p>Últimas 20 revisións desta conta:</p>
+          {history.data?.map((item) => (
+            <p key={item.id}>
+              {item.created_at}: {item.risk_kind} / {item.context_status} / {item.abstain_reason}
+            </p>
+          ))}
+        </form>
+      )}
+    </section>
+  );
+}
