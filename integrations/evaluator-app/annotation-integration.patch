diff --git a/src/lib/hyd-annotations.functions.ts b/src/lib/hyd-annotations.functions.ts
new file mode 100644
index 0000000..15026be
--- /dev/null
+++ b/src/lib/hyd-annotations.functions.ts
@@ -0,0 +1,47 @@
+import { createServerFn } from "@tanstack/react-start";
+import { z } from "zod";
+import { requireSupabaseAuth } from "@/integrations/supabase/auth-middleware";
+import { annotationRequest } from "./hyd-annotations";
+
+export const createHydAnnotation = createServerFn({ method: "POST" })
+  .middleware([requireSupabaseAuth])
+  .validator((input) => annotationRequest.parse(input))
+  .handler(async ({ data, context }) => {
+    const { data: record, error } = await context.supabase
+      .from("hyd_records")
+      .select("id,question,user_id")
+      .eq("id", data.recordId)
+      .eq("user_id", context.userId)
+      .single();
+    if (error || !record) throw new Error("Rexistro propio non dispoñible.");
+    const { createHash } = await import("node:crypto");
+    const { error: insertError } = await context.supabase.from("hyd_annotation_events").insert({
+      record_id: record.id,
+      user_id: context.userId,
+      record_sha256: createHash("sha256").update(record.question, "utf8").digest("hex"),
+      risk_kind: data.riskKind,
+      context_status: data.contextStatus,
+      abstain_reason: data.abstainReason,
+      status: "reviewed",
+      reviewer_kind: "human",
+    });
+    if (insertError)
+      throw new Error("Non se puido gardar a revisión; comproba migración e permisos.");
+    return { ok: true as const };
+  });
+
+export const listHydAnnotations = createServerFn({ method: "GET" })
+  .middleware([requireSupabaseAuth])
+  .validator((input) => z.object({ recordId: z.string().uuid() }).strict().parse(input))
+  .handler(async ({ data, context }) => {
+    const { data: events, error } = await context.supabase
+      .from("hyd_annotation_events")
+      .select("id,created_at,risk_kind,context_status,abstain_reason,status")
+      .eq("record_id", data.recordId)
+      .eq("user_id", context.userId)
+      .order("created_at", { ascending: false })
+      .order("id", { ascending: false })
+      .limit(20);
+    if (error) throw new Error("Historial non dispoñible; anotacións aínda non conectadas á base.");
+    return events ?? [];
+  });
