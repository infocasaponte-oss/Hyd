+++ b/src/lib/hyd-annotations.test.ts
@@ -0,0 +1,55 @@
+import { describe, it, expect } from "vitest";
+import { annotationRequest, portableAnnotation } from "./hyd-annotations";
+import { archivePayload } from "./hyd-archive";
+
+const base = {
+  recordId: "00000000-0000-4000-8000-000000000001",
+  humanConfirmed: true,
+  riskKind: "dangerous",
+  contextStatus: "unknown",
+  abstainReason: "dangerous",
+};
+describe("human annotation admission", () => {
+  it("requires confirmation and consistent explicit review", () => {
+    expect(annotationRequest.safeParse(base).success).toBe(true);
+    for (const change of [
+      { humanConfirmed: false },
+      { riskKind: "benign" },
+      { riskKind: "unknown", abstainReason: "unknown" },
+      { abstainReason: "missing_context" },
+      { reviewer_kind: "ai" },
+    ]) {
+      expect(annotationRequest.safeParse({ ...base, ...change }).success).toBe(false);
+    }
+    expect(
+      annotationRequest.safeParse({
+        ...base,
+        riskKind: "benign",
+        abstainReason: "none",
+        contextStatus: "sufficient",
+      }).success,
+    ).toBe(true);
+  });
+  it("exports every stored revision without private account identifiers in portable events", () => {
+    const row = {
+      id: "event-1",
+      record_id: "record-1",
+      user_id: "private-account",
+      record_sha256: "a".repeat(64),
+      format: "hyd-human-annotation/1",
+      reviewer_kind: "human",
+      status: "reviewed",
+      created_at: "2026-10-04T00:00:00Z",
+      risk_kind: "dangerous",
+      context_status: "unknown",
+      abstain_reason: "dangerous",
+    };
+    const event = portableAnnotation(row, "account-pseudonym");
+    expect(event).not.toHaveProperty("user_id");
+    expect(event.reviewer_id).toBe("account-pseudonym");
+    const history = [row, { ...row, id: "event-2", risk_kind: "benign", abstain_reason: "none" }];
+    const archive = archivePayload([], [], "mine", row.created_at, history);
+    expect(archive.annotations).toEqual(history);
+    expect(archive.counts.annotations).toBe(2);
+  });
+});
