index 0000000..5ceb15d
--- /dev/null
+++ b/src/lib/hyd-annotations.ts
@@ -0,0 +1,57 @@
+import { z } from "zod";
+
+export const annotationSelection = z
+  .object({
+    riskKind: z.enum(["unknown", "benign", "dangerous", "security", "privacy", "high_risk"]),
+    contextStatus: z.enum(["unknown", "sufficient", "missing"]),
+    abstainReason: z.enum(["unknown", "none", "dangerous", "missing_context"]),
+  })
+  .strict();
+
+export const annotationRequest = annotationSelection
+  .extend({
+    recordId: z.string().uuid(),
+    humanConfirmed: z.literal(true),
+  })
+  .strict()
+  .superRefine((value, context) => {
+    if (
+      value.riskKind === "unknown" &&
+      value.contextStatus === "unknown" &&
+      value.abstainReason === "unknown"
+    )
+      context.addIssue({ code: "custom", message: "Escolle unha marca explícita." });
+    if (value.abstainReason === "dangerous" && value.riskKind !== "dangerous")
+      context.addIssue({ code: "custom", message: "Perigosa require risco perigoso." });
+    if (value.abstainReason === "missing_context" && value.contextStatus !== "missing")
+      context.addIssue({ code: "custom", message: "Falta contexto require contexto ausente." });
+  });
+
+export type AnnotationDbRow = {
+  id: string;
+  record_id: string;
+  user_id: string;
+  record_sha256: string;
+  format: string;
+  reviewer_kind: string;
+  status: string;
+  created_at: string;
+  risk_kind: string;
+  context_status: string;
+  abstain_reason: string;
+};
+
+export function portableAnnotation(row: AnnotationDbRow, reviewerId: string) {
+  return {
+    format: row.format,
+    event_id: row.id,
+    record_sha256: row.record_sha256,
+    reviewer_id: reviewerId,
+    reviewer_kind: row.reviewer_kind,
+    created_at: row.created_at,
+    status: row.status,
+    risk_kind: row.risk_kind,
+    context_status: row.context_status,
+    abstain_reason: row.abstain_reason,
+  };
+}
