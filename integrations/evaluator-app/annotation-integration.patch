diff --git a/supabase/migrations/20261004_hyd_annotation_events.sql b/supabase/migrations/20261004_hyd_annotation_events.sql
new file mode 100644
index 0000000..17c34b9
--- /dev/null
+++ b/supabase/migrations/20261004_hyd_annotation_events.sql
@@ -0,0 +1,40 @@
+-- Additive: never rewrites legacy abstain marks, AI suggestions or questions.
+begin;
+create table public.hyd_annotation_events (
+  id uuid primary key default gen_random_uuid(),
+  record_id uuid not null references public.hyd_records(id) on delete cascade,
+  user_id uuid not null references auth.users(id),
+  format text not null default 'hyd-human-annotation/1' check (format = 'hyd-human-annotation/1'),
+  reviewer_kind text not null check (reviewer_kind = 'human'),
+  record_sha256 text not null check (record_sha256 ~ '^[0-9a-f]{64}$'),
+  status text not null check (status in ('pending','reviewed')),
+  risk_kind text not null check (risk_kind in ('unknown','benign','dangerous','security','privacy','high_risk')),
+  context_status text not null check (context_status in ('unknown','sufficient','missing')),
+  abstain_reason text not null check (abstain_reason in ('unknown','none','dangerous','missing_context')),
+  created_at timestamptz not null default now(),
+  check (status <> 'pending' or (risk_kind = 'unknown' and context_status = 'unknown' and abstain_reason = 'unknown')),
+  check (status <> 'reviewed' or (risk_kind <> 'unknown' or context_status <> 'unknown' or abstain_reason <> 'unknown')),
+  check (abstain_reason <> 'dangerous' or risk_kind = 'dangerous'),
+  check (abstain_reason <> 'missing_context' or context_status = 'missing')
+);
+create index hyd_annotation_record_owner on public.hyd_annotation_events(user_id, record_id, created_at);
+alter table public.hyd_annotation_events enable row level security;
+revoke all on public.hyd_annotation_events from anon;
+revoke update, delete on public.hyd_annotation_events from authenticated;
+grant select, insert on public.hyd_annotation_events to authenticated;
+create policy hyd_annotation_owner_select on public.hyd_annotation_events for select to authenticated
+  using (user_id = auth.uid() and exists (
+    select 1 from public.hyd_records r where r.id = record_id and r.user_id = auth.uid()));
+create policy hyd_annotation_owner_insert on public.hyd_annotation_events for insert to authenticated
+  with check (user_id = auth.uid() and exists (
+    select 1 from public.hyd_records r where r.id = record_id and r.user_id = auth.uid()
+      and r.consent = true and encode(sha256(convert_to(r.question,'UTF8')),'hex') = record_sha256));
+-- UPDATE/DELETE are not granted: changing a mark adds another event.
+-- Server-assigned timestamps prevent backdating an event through the API.
+create function public.hyd_annotation_timestamp() returns trigger
+language plpgsql set search_path = public as $$
+begin new.created_at := now(); return new; end;
+$$;
+create trigger hyd_annotation_timestamp before insert on public.hyd_annotation_events
+for each row execute function public.hyd_annotation_timestamp();
+commit;
